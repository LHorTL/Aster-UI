{
  "name": "@fangxinyan/aster-ui",
  "version": "0.5.0",
  "license": "MIT",
  "type": "module",
  "description": "Aster UI（星序）— 安静、精确的 React 组件库",
  "author": "fangxinyan",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LHorTL/Aster-UI.git"
  },
  "homepage": "https://github.com/LHorTL/Aster-UI#readme",
  "bugs": {
    "url": "https://github.com/LHorTL/Aster-UI/issues"
  },
  "keywords": [
    "react",
    "ui",
    "components",
    "design-system",
    "aster-ui",
    "affectui",
    "typescript",
    "accessible",
    "electron",
    "ai-agents"
  ],
  "engines": {
    "node": ">=18"
  },
  "sideEffects": [
    "*.css",
    "**/*.css"
  ],
  "main": "./dist/cjs/index.cjs",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "files": [
    "dist",
    "DESIGN.md",
    "CHANGELOG.md",
    "assets/showcase-light.png",
    "assets/showcase-dark.png",
    "assets/INTER-LICENSE.txt"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.cts",
        "default": "./dist/cjs/index.cjs"
      }
    },
    "./runtime": {
      "import": {
        "types": "./dist/esm/runtime.d.ts",
        "default": "./dist/esm/runtime.js"
      },
      "require": {
        "types": "./dist/cjs/runtime.d.cts",
        "default": "./dist/cjs/runtime.cjs"
      }
    },
    "./core": {
      "import": {
        "types": "./dist/esm/ui.d.ts",
        "default": "./dist/esm/ui.js"
      },
      "require": {
        "types": "./dist/cjs/ui.d.cts",
        "default": "./dist/cjs/ui.cjs"
      }
    },
    "./ui-pro": {
      "import": {
        "types": "./dist/esm/ui-pro.d.ts",
        "default": "./dist/esm/ui-pro.js"
      },
      "require": {
        "types": "./dist/cjs/ui-pro.d.cts",
        "default": "./dist/cjs/ui-pro.cjs"
      }
    },
    "./examples": {
      "import": {
        "types": "./dist/esm/examples.d.ts",
        "default": "./dist/esm/examples.js"
      },
      "require": {
        "types": "./dist/cjs/examples.d.cts",
        "default": "./dist/cjs/examples.cjs"
      }
    },
    "./theme": {
      "import": {
        "types": "./dist/esm/theme.d.ts",
        "default": "./dist/esm/theme.js"
      },
      "require": {
        "types": "./dist/cjs/theme.d.cts",
        "default": "./dist/cjs/theme.cjs"
      }
    },
    "./primitives": {
      "import": {
        "types": "./dist/esm/primitives/index.d.ts",
        "default": "./dist/esm/primitives/index.js"
      },
      "require": {
        "types": "./dist/cjs/primitives/index.d.cts",
        "default": "./dist/cjs/primitives/index.cjs"
      }
    },
    "./icons": {
      "import": {
        "types": "./dist/esm/icons.d.ts",
        "default": "./dist/esm/icons.js"
      },
      "require": {
        "types": "./dist/cjs/icons.d.cts",
        "default": "./dist/cjs/icons.cjs"
      }
    },
    "./motion": {
      "import": {
        "types": "./dist/esm/motion.d.ts",
        "default": "./dist/esm/motion.js"
      },
      "require": {
        "types": "./dist/cjs/motion.d.cts",
        "default": "./dist/cjs/motion.cjs"
      }
    },
    "./patterns/*.css": "./dist/patterns/*.css",
    "./patterns/*": {
      "import": {
        "types": "./dist/esm/patterns/*.d.ts",
        "default": "./dist/esm/patterns/*.js"
      },
      "require": {
        "types": "./dist/cjs/patterns/*.d.cts",
        "default": "./dist/cjs/patterns/*.cjs"
      }
    },
    "./screens/*.css": "./dist/screens/*.css",
    "./illustrations/*.css": "./dist/illustrations/*.css",
    "./tokens.css": "./dist/tokens.css",
    "./core.css": "./dist/core.css",
    "./styles.css": "./dist/styles.css",
    "./ui.css": "./dist/ui.css",
    "./ui-pro.css": "./dist/ui-pro.css",
    "./motion.css": "./dist/motion.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node scripts/build-lib.mjs",
    "build:showcase": "node build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "lint:arch": "node scripts/lint-architecture.mjs",
    "check:pkg": "node scripts/check-package.mjs",
    "prepublishOnly": "npm run lint:arch && npm run build && npm run typecheck && npm run check:pkg && npm run test",
    "new:component": "node scripts/new-component.mjs",
    "test": "vitest run",
    "visual:update": "node scripts/visual-regression.mjs --update",
    "visual:check": "node scripts/visual-regression.mjs",
    "visual:theme:update": "node scripts/visual-regression.mjs --update --components button,usage-meter,model-picker,color-picker --accents blue,violet,green,orange,#0a8f7a",
    "visual:theme:check": "node scripts/visual-regression.mjs --components button,usage-meter,model-picker,color-picker --accents blue,violet,green,orange,#0a8f7a"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@types/node": "^25.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "esbuild": "^0.25.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sharp": "^0.35.4",
    "typescript": "^5.9.0",
    "vite": "^6.0.0",
    "vitest": "^4.1.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
